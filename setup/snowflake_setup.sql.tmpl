-- Snowflake setup for SAML -> Entra OIDC -> Snowflake per-user passthrough.
-- Rendered by setup/render.py from setup/entra.env; run as ACCOUNTADMIN:
--   snow sql -c <conn> -f setup/snowflake_setup.sql
-- Placeholders: {{TENANT_ID}} {{RES_V2_APP_ID}} {{RES_V1_APP_ID}} {{SF_LOGIN_USER}} {{IS_AGENTIC}}

USE ROLE ACCOUNTADMIN;

-- App roles + one role the app must never reach (used to detect secondary-role leakage)
CREATE ROLE IF NOT EXISTS APP_ANALYST;
CREATE ROLE IF NOT EXISTS APP_READER;
CREATE ROLE IF NOT EXISTS APP_RESTRICTED;
GRANT ROLE APP_ANALYST    TO USER {{SF_LOGIN_USER}};
GRANT ROLE APP_READER     TO USER {{SF_LOGIN_USER}};
GRANT ROLE APP_RESTRICTED TO USER {{SF_LOGIN_USER}};

CREATE WAREHOUSE IF NOT EXISTS SSO_DEMO_WH WAREHOUSE_SIZE = XSMALL AUTO_SUSPEND = 60 INITIALLY_SUSPENDED = TRUE;
GRANT USAGE ON WAREHOUSE SSO_DEMO_WH TO ROLE APP_ANALYST;
GRANT USAGE ON WAREHOUSE SSO_DEMO_WH TO ROLE APP_READER;
GRANT USAGE ON WAREHOUSE SSO_DEMO_WH TO ROLE APP_RESTRICTED;

-- Demo data: APP schema for app roles, SECRET schema only for APP_RESTRICTED
CREATE DATABASE IF NOT EXISTS SSO_DEMO_DB;
CREATE SCHEMA IF NOT EXISTS SSO_DEMO_DB.APP;
CREATE SCHEMA IF NOT EXISTS SSO_DEMO_DB.SECRET;
CREATE OR REPLACE TABLE SSO_DEMO_DB.APP.POLICIES (ID INT, PRODUCT STRING, PREMIUM NUMBER(10,2), CUSTOMER_EMAIL STRING);
INSERT INTO SSO_DEMO_DB.APP.POLICIES VALUES
  (1,'Car',420.00,'jane.doe@example.com'),(2,'Home',310.50,'max.mustermann@example.com'),(3,'Travel',59.90,'erika.muster@example.com');

-- Agent identity: the same user and role see CUSTOMER_EMAIL in clear in a normal session,
-- but masked whenever the session is agent-activated (IS_AGENTIC = TRUE on the integration).
CREATE OR REPLACE MASKING POLICY SSO_DEMO_DB.APP.MASK_EMAIL_FROM_AGENTS AS (val STRING) RETURNS STRING ->
  CASE
    WHEN SYS_CONTEXT('SNOWFLAKE$CURRENT', 'IS_AGENT_ACTIVATED')::BOOLEAN = TRUE THEN '***agent-masked***'
    ELSE val
  END;
ALTER TABLE SSO_DEMO_DB.APP.POLICIES MODIFY COLUMN CUSTOMER_EMAIL
  SET MASKING POLICY SSO_DEMO_DB.APP.MASK_EMAIL_FROM_AGENTS;
CREATE OR REPLACE TABLE SSO_DEMO_DB.SECRET.CLAIMS_PII (ID INT, NAME STRING, IBAN STRING);
INSERT INTO SSO_DEMO_DB.SECRET.CLAIMS_PII VALUES (1,'Jane Doe','XX00 0000 0000 0000 0000 00');

GRANT USAGE ON DATABASE SSO_DEMO_DB TO ROLE APP_ANALYST;
GRANT USAGE ON DATABASE SSO_DEMO_DB TO ROLE APP_READER;
GRANT USAGE ON DATABASE SSO_DEMO_DB TO ROLE APP_RESTRICTED;
GRANT USAGE ON SCHEMA SSO_DEMO_DB.APP TO ROLE APP_ANALYST;
GRANT USAGE ON SCHEMA SSO_DEMO_DB.APP TO ROLE APP_READER;
GRANT SELECT ON ALL TABLES IN SCHEMA SSO_DEMO_DB.APP TO ROLE APP_ANALYST;
GRANT SELECT ON ALL TABLES IN SCHEMA SSO_DEMO_DB.APP TO ROLE APP_READER;
GRANT USAGE ON SCHEMA SSO_DEMO_DB.SECRET TO ROLE APP_RESTRICTED;
GRANT SELECT ON ALL TABLES IN SCHEMA SSO_DEMO_DB.SECRET TO ROLE APP_RESTRICTED;

-- ===================== Recommended: dedicated v2 integration =====================
-- v2 tokens have issuer https://login.microsoftonline.com/<tid>/v2.0, distinct from the
-- v1 issuer an existing (central) Entra integration typically uses.
-- Tokens carry session:role:<ROLE> scopes -> Snowflake disables secondary roles itself.
-- This allowlist is the after-the-fact restriction: scope a superset in Entra, enable here.
CREATE OR REPLACE SECURITY INTEGRATION ENTRA_SSO_SCOPED_V2
  TYPE = EXTERNAL_OAUTH
  ENABLED = TRUE
  EXTERNAL_OAUTH_TYPE = AZURE
  EXTERNAL_OAUTH_ISSUER = 'https://login.microsoftonline.com/{{TENANT_ID}}/v2.0'
  EXTERNAL_OAUTH_JWS_KEYS_URL = 'https://login.microsoftonline.com/{{TENANT_ID}}/discovery/v2.0/keys'
  EXTERNAL_OAUTH_AUDIENCE_LIST = ('{{RES_V2_APP_ID}}')            -- v2 aud = client id GUID
  EXTERNAL_OAUTH_TOKEN_USER_MAPPING_CLAIM = 'preferred_username'  -- v2 tokens have no upn
  EXTERNAL_OAUTH_SNOWFLAKE_USER_MAPPING_ATTRIBUTE = 'LOGIN_NAME'
  EXTERNAL_OAUTH_ANY_ROLE_MODE = 'ENABLE'
  EXTERNAL_OAUTH_ALLOWED_ROLES_LIST = ('APP_ANALYST', 'APP_READER')
  IS_AGENTIC = {{IS_AGENTIC}};  -- TRUE: every session is agent-activated (AGENT_TYPE = EXTERNAL_AGENT)

-- ===================== Fallback: role-any on the v1 issuer ======================
-- Skip this block if your account already has an Entra v1 integration (only one per issuer).
-- APP_RESTRICTED is allowlisted on purpose to demonstrate secondary-role leakage.
CREATE OR REPLACE SECURITY INTEGRATION ENTRA_SSO_ROLE_ANY_V1
  TYPE = EXTERNAL_OAUTH
  ENABLED = TRUE
  EXTERNAL_OAUTH_TYPE = AZURE
  EXTERNAL_OAUTH_ISSUER = 'https://sts.windows.net/{{TENANT_ID}}/'
  EXTERNAL_OAUTH_JWS_KEYS_URL = 'https://login.microsoftonline.com/{{TENANT_ID}}/discovery/v2.0/keys'
  EXTERNAL_OAUTH_AUDIENCE_LIST = ('api://{{RES_V1_APP_ID}}')
  EXTERNAL_OAUTH_TOKEN_USER_MAPPING_CLAIM = 'upn'
  EXTERNAL_OAUTH_SNOWFLAKE_USER_MAPPING_ATTRIBUTE = 'LOGIN_NAME'
  EXTERNAL_OAUTH_ANY_ROLE_MODE = 'ENABLE'
  EXTERNAL_OAUTH_ALLOWED_ROLES_LIST = ('APP_ANALYST', 'APP_READER', 'APP_RESTRICTED')
  IS_AGENTIC = {{IS_AGENTIC}};

-- Backstop for role-any: created, not attached (attaching also affects the user's Snowsight sessions).
--   ALTER USER {{SF_LOGIN_USER}} SET SESSION POLICY SSO_DEMO_DB.APP.NO_SECONDARY_ROLES;
CREATE SESSION POLICY IF NOT EXISTS SSO_DEMO_DB.APP.NO_SECONDARY_ROLES
  ALLOWED_SECONDARY_ROLES = ()
  COMMENT = 'SSO passthrough demo: no secondary roles';
